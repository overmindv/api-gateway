  state: String!
}

type LearnerGoal {
  id: ID!
  title: String!
  templateVersion: String!
  targetTopics: [ID!]!
  deadline: String!
  weeklyMinutes: Int!
  active: Boolean!
  languages: [String!]!
  formats: [String!]!
  selfAssessments: [LearnerSelfAssessment!]!
