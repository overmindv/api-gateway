  outcomes: [LearnerDiagnosticOutcome!]!
}

type LearnerDiagnosticSession {
  id: ID!
  goalId: ID!
  goalVersion: Int!
  status: String!
  baseline: String!
  tasks: [LearnerDiagnosticTask!]!
  estimatedMinutes: Int!
  stopRule: LearnerDiagnosticStopRule!
  startedAt: String!
  expiresAt: String!
  skippedAt: String
  finalizedAt: String
