  version: Int!
  createdAt: String!
  updatedAt: String!
  skills: [LearnerTopicSkill!]!
  feasibility: String!
  feasibilityReason: String!
}

type LearnerDiagnosticTask {
  taskId: ID!
  taskVersionId: ID!
  topicId: ID!
  estimatedMinutes: Int!
}

type LearnerDiagnosticStopRule {
  policyVersion: String!
  maxTasks: Int!
  budgetMinutes: Int!
}

type LearnerDiagnosticTopicCoverage {
  topicId: ID!
  assigned: Int!
  assessed: Int!
  observation: String!
  uncertainty: String!
}

type LearnerDiagnosticOutcome {
  taskId: ID!
  taskVersionId: ID!
  topicId: ID!
  submissionId: ID!
  eventId: ID!
  correctionVersion: Int!
  verdict: String!
  gradedAt: String!
}

type LearnerDiagnosticReport {
  assigned: Int!
  assessed: Int!
